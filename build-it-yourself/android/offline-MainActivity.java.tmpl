package __PKG__;

import android.app.Activity;
import android.content.Intent;
import android.content.res.Configuration;
import android.graphics.Color;
import android.net.Uri;
import android.os.Bundle;
import android.util.Base64;
import android.view.View;
import android.view.Window;
import android.webkit.JavascriptInterface;
import android.webkit.ValueCallback;
import android.webkit.WebChromeClient;
import android.webkit.WebResourceRequest;
import android.webkit.WebResourceResponse;
import android.webkit.WebSettings;
import android.webkit.WebView;
import android.webkit.WebViewClient;

import java.io.ByteArrayInputStream;
import java.io.InputStream;
import java.io.OutputStream;
import java.util.HashMap;
import java.util.Map;

/**
 * __LABEL__ for Android.
 *
 * The screens are bundled inside the app and served from https://__HOST__/ (they never leave the phone),
 * so the app always opens, even when the server is down. The data lives in this app's own
 * offline copy and syncs with the server over Tailscale.
 */
public class MainActivity extends Activity {
    private static final String HOST = "__HOST__";
    private static final String START = "https://" + HOST + "__START__";
    private static final int REQ_PICK_FILE = 1;
    private static final int REQ_SAVE_FILE = 2;

    private WebView web;
    private ValueCallback<Uri[]> fileCallback;
    private byte[] pendingSave;

    @Override
    protected void onCreate(Bundle state) {
        super.onCreate(state);
        boolean dark = (getResources().getConfiguration().uiMode & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;
        Window w = getWindow();
        w.setStatusBarColor(dark ? Color.parseColor("__BAR_DARK__") : Color.parseColor("__BAR__"));
        w.setNavigationBarColor(dark ? Color.parseColor("__BAR_DARK__") : Color.parseColor("__BG__"));
        if (!dark && android.os.Build.VERSION.SDK_INT >= 26) {
            w.getDecorView().setSystemUiVisibility(0x00000010); // light navigation bar
        }

        web = new WebView(this);
        web.setBackgroundColor(dark ? Color.parseColor("__BAR_DARK__") : Color.parseColor("__BG__"));
        setContentView(web);

        WebSettings s = web.getSettings();
        s.setJavaScriptEnabled(true);
        s.setDomStorageEnabled(true);
        s.setDatabaseEnabled(true);
        s.setAllowFileAccess(false);
        s.setAllowContentAccess(false);
        s.setMediaPlaybackRequiresUserGesture(true);
        s.setSupportZoom(false);
        s.setUserAgentString(s.getUserAgentString() + " RootCellar/Android");

        web.setWebViewClient(new WebViewClient() {
            @Override
            public WebResourceResponse shouldInterceptRequest(WebView view, WebResourceRequest req) {
                Uri u = req.getUrl();
                if ("https".equals(u.getScheme()) && HOST.equals(u.getHost())) return asset(u.getPath());
                return null; // everything else (the server) goes to the network normally
            }

            @Override
            @SuppressWarnings("deprecation") // the String form is the one in the Android 6 SDK; newer Android still calls it
            public boolean shouldOverrideUrlLoading(WebView view, String url) {
                Uri u = Uri.parse(url);
                if (HOST.equals(u.getHost())) return false;
                try { startActivity(new Intent(Intent.ACTION_VIEW, u)); } catch (Exception ignored) { }
                return true;
            }
        });

        web.setWebChromeClient(new WebChromeClient() {
            @Override
            public boolean onShowFileChooser(WebView view, ValueCallback<Uri[]> callback, FileChooserParams params) {
                if (fileCallback != null) fileCallback.onReceiveValue(null);
                fileCallback = callback;
                Intent pick = new Intent(Intent.ACTION_GET_CONTENT);
                pick.addCategory(Intent.CATEGORY_OPENABLE);
                pick.setType("*/*");
                try {
                    startActivityForResult(Intent.createChooser(pick, "Choose a file"), REQ_PICK_FILE);
                } catch (Exception e) {
                    fileCallback = null;
                    return false;
                }
                return true;
            }
        });

        web.addJavascriptInterface(new Bridge(), "CBAndroid");

        if (state != null) web.restoreState(state);
        else web.loadUrl(START);
    }

    /** Serve the bundled screens from assets/www. */
    private WebResourceResponse asset(String path) {
        if (path == null || path.equals("") || path.equals("/")) path = "__ROOT_FILE__";
        if (path.contains("..")) return notFound();
        String file = "www" + path;
        Map<String, String> headers = new HashMap<String, String>();
        headers.put("Cache-Control", "no-cache");
        try {
            InputStream in = getAssets().open(file);
            return new WebResourceResponse(mime(path), "utf-8", 200, "OK", headers, in);
        } catch (Exception e) {
            // Paths without an extension: /pantry -> pantry.html, otherwise the main screen (like the server does).
            if (!path.contains(".")) {
                try { return new WebResourceResponse("text/html", "utf-8", 200, "OK", headers, getAssets().open("www" + path + ".html")); }
                catch (Exception ignored) { }
                try { return new WebResourceResponse("text/html", "utf-8", 200, "OK", headers, getAssets().open("www/index.html")); }
                catch (Exception ignored) { }
            }
            return notFound();
        }
    }

    private WebResourceResponse notFound() {
        return new WebResourceResponse("text/plain", "utf-8", 404, "Not Found", new HashMap<String, String>(), new ByteArrayInputStream(new byte[0]));
    }

    private static String mime(String p) {
        String l = p.toLowerCase();
        if (l.endsWith(".html")) return "text/html";
        if (l.endsWith(".js")) return "text/javascript";
        if (l.endsWith(".css")) return "text/css";
        if (l.endsWith(".png")) return "image/png";
        if (l.endsWith(".svg")) return "image/svg+xml";
        if (l.endsWith(".json") || l.endsWith(".webmanifest")) return "application/json";
        return "application/octet-stream";
    }

    /** Lets the app save exports (CSV, backups) where you choose. */
    private class Bridge {
        @JavascriptInterface
        public void saveFile(final String name, final String base64, final String mimeType) {
            pendingSave = Base64.decode(base64, Base64.DEFAULT);
            runOnUiThread(new Runnable() {
                @Override
                public void run() {
                    Intent i = new Intent(Intent.ACTION_CREATE_DOCUMENT);
                    i.addCategory(Intent.CATEGORY_OPENABLE);
                    i.setType(mimeType == null || mimeType.length() == 0 ? "application/octet-stream" : mimeType);
                    i.putExtra(Intent.EXTRA_TITLE, name);
                    try { startActivityForResult(i, REQ_SAVE_FILE); }
                    catch (Exception e) { toastJs("Couldn't open the save screen"); }
                }
            });
        }
    }

    private void toastJs(String msg) {
        String safe = msg.replace("\\", "\\\\").replace("'", "\\'");
        web.evaluateJavascript("(function(){var t=document.getElementById('toast');if(t){t.textContent='" + safe + "';t.hidden=false;setTimeout(function(){t.hidden=true},2500);}})()", null);
    }

    @Override
    protected void onActivityResult(int request, int result, Intent data) {
        super.onActivityResult(request, result, data);
        if (request == REQ_PICK_FILE) {
            if (fileCallback != null) {
                Uri[] picked = null;
                if (result == RESULT_OK && data != null && data.getData() != null) picked = new Uri[] { data.getData() };
                fileCallback.onReceiveValue(picked);
                fileCallback = null;
            }
        } else if (request == REQ_SAVE_FILE) {
            byte[] bytes = pendingSave;
            pendingSave = null;
            if (result != RESULT_OK || data == null || data.getData() == null || bytes == null) return;
            try {
                OutputStream out = getContentResolver().openOutputStream(data.getData());
                out.write(bytes);
                out.close();
                toastJs("Saved");
            } catch (Exception e) {
                toastJs("Couldn't save the file");
            }
        }
    }

    @Override
    public void onBackPressed() {
        web.evaluateJavascript("(window.CBNativeBack ? window.CBNativeBack() : false)", new ValueCallback<String>() {
            @Override
            public void onReceiveValue(String handled) {
                if (!"true".equals(handled)) moveTaskToBack(true);
            }
        });
    }

    @Override
    protected void onSaveInstanceState(Bundle out) {
        super.onSaveInstanceState(out);
        web.saveState(out);
    }

    @Override
    protected void onResume() {
        super.onResume();
        web.onResume();
        // Coming back to the app: check the server right away instead of waiting for the next 10-second tick.
        web.evaluateJavascript("window.CBSync && window.CBSync.kick()", null);
    }

    @Override
    protected void onPause() {
        web.onPause();
        super.onPause();
    }
}
